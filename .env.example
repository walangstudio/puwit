APP_ENV=development
APP_DEBUG=true

# DB_DRIVER: mysql | pgsql | sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=puwit
DB_USER=root
DB_PASS=

# For SQLite only
DB_PATH=/path/to/database.sqlite

JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_TTL=3600

# Bootstrap admin key — remove after first real admin key is created
PUWIT_ADMIN_KEY=

CORS_ORIGINS=*
