{
    "name": "walangstudio/puwit",
    "description": "PHP Universal Web Integration Toolkit",
    "version": "0.3.1",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Puwit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puwit\\Tests\\": "tests/",
            "Puwit\\E2E\\":   "e2e/"
        }
    },
    "scripts": {
        "test":     "phpunit --testdox",
        "test:e2e": "phpunit -c phpunit.e2e.xml --testdox"
    }
}
