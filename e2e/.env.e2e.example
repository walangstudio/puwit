# E2E test configuration
# Copy to .env.e2e and fill in your values.
# NEVER commit .env.e2e — it contains your real admin key.

# Base URL of the running PUWIT instance (no trailing slash)
# Examples:
#   http://localhost:8000              (php -S localhost:8000 -t public/)
#   http://localhost/puwit/public      (AMPPS / XAMPP in a subfolder)
#   http://puwit.test                  (virtual host)
E2E_BASE_URL=http://localhost:8000

# The PUWIT_ADMIN_KEY value from your .env file
E2E_ADMIN_KEY=my-bootstrap-key
